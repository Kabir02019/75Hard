# ---------------------------------------------------------------------------
# 75 Hard Showdown — environment variables
# ---------------------------------------------------------------------------
# Fill these in on Vercel (Project Settings -> Environment Variables), or the
# Deploy Button will prompt you for each one during setup.

# --- Storage -----------------------------------------------------------
# Add the "Redis" integration (Upstash) from the Vercel Marketplace to your
# project's Storage tab. It fills these two in for you automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron security -------------------------------------------------------
# Any random string. Vercel automatically sends this back as the
# Authorization header when it triggers the daily cron job.
CRON_SECRET=change-me-to-a-random-string

# --- Player 1 --------------------------------------------------------------
PERSON1_NAME=
# The private, unguessable slug for this person's check-in link:
#   https://your-app.vercel.app/check-in/PERSON1_TOKEN
PERSON1_TOKEN=
# Phone number in international format, e.g. +15551234567
PERSON1_PHONE=
# From callmebot.com — see README for the 2-minute signup steps
PERSON1_CALLMEBOT_APIKEY=

# --- Player 2 --------------------------------------------------------------
PERSON2_NAME=
PERSON2_TOKEN=
PERSON2_PHONE=
PERSON2_CALLMEBOT_APIKEY=

# --- Player 3 --------------------------------------------------------------
PERSON3_NAME=
PERSON3_TOKEN=
PERSON3_PHONE=
PERSON3_CALLMEBOT_APIKEY=
